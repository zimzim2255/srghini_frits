  }

  .sergio-visual {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 600px;
    overflow: hidden;
    background-color: #f4efe6;
  }

  .sergio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(0);
    transform-origin: center center;
    transition: transform 0.1s ease-out;
  }

  @media (max-width: 768px) {
    .sergio-content {
      padding: 4rem 1.5rem 3rem;
    }

    .sergio-headline {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .sergio-visual {
      height: 50vh;
      min-height: 400px;
    }

    .sergio-overlay {
      padding: 1rem;
    }

    .sergio-logo {
      width: 40px;
      height: 40px;
    }

    .sergio-nav-btn {
      font-size: 0.625rem;
      padding: 0.5rem 1rem;
    }
  }

 .art-frites {
   width: 100%;
   padding: 6rem 2rem;
   box-sizing: border-box;
   background-color: #FFFFFF;
 }

    .art-frites-grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr 1fr;
      grid-template-rows: auto auto;
      gap: 12rem;
      max-width: 1800px;
      margin: 0 auto;
    }

    .art-image {
      overflow: hidden;
    }

    .art-image img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
    }

    .art-img-left-1 {
      grid-column: 1;
      grid-row: 1;
      transform: translateY(-80px) translateX(-60px);
    }

    .art-img-center {
      grid-column: 2;
      grid-row: 1;
    }

    .art-img-left-2 {
      grid-column: 3;
      grid-row: 1;
      transform: translateY(-60px) translateX(60px);
    }

     .art-frites-content {
       grid-column: 2;
       grid-row: 2;
       text-align: center;
       padding: 3rem 1rem;
       display: flex;
       flex-direction: column;
       align-items: center;
       gap: 1.5rem;
       transform: translateY(-80px);
       background: none;
     }

    .art-img-right-1 {
      grid-column: 1;
