---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Employment">
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-label">EMPLOIS</span>
      <h1 class="hero-title">
        <span>REJOIGNEZ LA</span>
        <span>FAMILLE</span>
        <span>FRITES ATELIER</span>
      </h1>
      <p class="hero-body">
        Pour bâtir quelque chose d'exceptionnel, il faut s'entourer des bonnes personnes. Vous avez le sens de l'hospitalité, l'exigence et l'art du détail? Votre place est parmi nous. Découvrez nos postes dans les différents Ateliers et contribuez à créer des expériences inoubliables.
      </p>
      <a href="#positions" class="hero-cta">FAITES DEFILER POUR DECOUVRIR</a>
    </div>
  </section>

  <section class="job-listings" id="positions">
    <div class="job-container">
      <div class="job-row">
        <div class="city-name">ANVERS</div>
        <div class="job-list">
          <div class="job-item">
            <span class="job-title">ASSISTANT(E) MANAGER D'ATELIER</span>
            <span class="badge">TEMPS PARTIEL</span>
          </div>
          <div class="job-item">
            <span class="job-title">COLLABORATEUR(TRICE) D'ATELIER</span>
            <span class="badge">TEMPS PLEIN</span>
          </div>
          <div class="job-item">
            <span class="job-title">CANDIDATURE SPONTANÉE</span>
            <span class="badge">TEMPS PARTIEL / TEMPS PLEIN</span>
          </div>
        </div>
      </div>

      <div class="job-row">
        <div class="city-name">BRUXELLES</div>
        <div class="job-list">
          <div class="job-item">
            <span class="job-title">ASSISTANT(E) MANAGER D'ATELIER</span>
            <span class="badge">TEMPS PLEIN</span>
          </div>
          <div class="job-item">
            <span class="job-title">CANDIDATURE SPONTANÉE</span>
            <span class="badge">TEMPS PARTIEL / TEMPS PLEIN</span>
          </div>
        </div>
      </div>

      <div class="job-row">
        <div class="city-name">GAND</div>
        <div class="job-list">
          <div class="job-item">
            <span class="job-title">ASSISTANT(E) MANAGER D'ATELIER</span>
            <span class="badge">TEMPS PLEIN</span>
          </div>
          <div class="job-item">
            <span class="job-title">COLLABORATEUR(TRICE) D'ATELIER</span>
            <span class="badge">TEMPS PLEIN</span>
          </div>
          <div class="job-item">
            <span class="job-title">MANAGER D'ATELIER</span>
            <span class="badge">TEMPS PLEIN</span>
          </div>
          <div class="job-item">
            <span class="job-title">CANDIDATURE SPONTANÉE</span>
            <span class="badge">TEMPS PARTIEL / TEMPS PLEIN</span>
          </div>
        </div>
      </div>

      <div class="job-row">
        <div class="city-name">ROOSENDAAL</div>
        <div class="job-list">
          <div class="job-item job-item-stacked">
            <span class="job-title">COLLABORATEUR(TRICE) D'ATELIER</span>
            <span class="badge">TEMPS PARTIEL / TEMPS PLEIN</span>
          </div>
        </div>
      </div>

      <div class="job-row">
        <div class="city-name">BUREAU DE SIÈGE</div>
        <div class="job-list">
          <div class="job-item">
            <span class="job-title">CANDIDATURE SPONTANÉE</span>
            <span class="badge">TEMPS PARTIEL / TEMPS PLEIN</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

.hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://www.globalfries.be/site/assets/files/1821/globalfries-lanceringsvisual.1500x0.jpg');
    background-size: cover;
    background-position: center center;
}

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(17, 29, 61, 0.55);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 650px;
    padding: 2rem;
  }

  .hero-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #F4F1EA;
    margin-bottom: 2rem;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    font-family: 'Titan One', var(--font-serif), system-ui, serif;
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #F4F1EA;
    line-height: 0.95;
    margin-bottom: 2.5rem;
  }

  .hero-body {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.7;
    color: #F4F1EA;
    opacity: 0.9;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    padding: 1rem 2.5rem;
    border: 1px solid #FFFFFF;
    border-radius: 50px;
    transition: all 0.3s ease;
    background: transparent;
  }

  .hero-cta:hover {
    background-color: #FFFFFF;
    color: #1A1A1A;
  }

  @media (max-width: 768px) {
    .hero-content {
      padding: 1.5rem;
    }

    .hero-title {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .hero-body {
      font-size: 0.9rem;
    }

    .hero-cta {
      padding: 0.875rem 2rem;
      font-size: 0.625rem;
    }
  }

  .job-listings {
    background-color: #F4EFE6;
    padding: 6rem 2rem;
  }

  .job-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .job-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid #D4CDC0;
    padding: 2.5rem 0;
  }

  .job-row:first-child {
    border-top: 1px solid #D4CDC0;
  }

  .city-name {
    flex: 0 0 30%;
    font-family: 'Titan One', var(--font-serif), system-ui, serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #1A1A1A;
    line-height: 1.1;
  }

  .job-list {
    flex: 0 0 65%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .job-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
  }

  .job-item:hover .job-title {
    text-decoration: underline;
  }

  .job-title {
    font-family: var(--font-sans);
    font-size: clamp(0.75rem, 1.5vw, 0.9rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #1A1A1A;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }

  .badge {
    background-color: #E6B845;
    color: #1A1A1A;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .job-item-stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .job-listings {
      padding: 4rem 1.5rem;
    }

    .job-row {
      flex-direction: column;
      gap: 1.5rem;
      padding: 2rem 0;
    }

    .city-name {
      flex: 0 0 100%;
    }

    .job-list {
      flex: 0 0 100%;
      padding-left: 0.5rem;
    }

    .job-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .job-title {
      font-size: 0.8rem;
    }
  }
</style>