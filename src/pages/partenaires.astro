---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Partenariats">
  <section class="partnerships">
    <div class="partnerships-header">
      <span class="header-label">PARTENARIATS</span>
      <h1 class="header-title">
        <span>COLLABORER</span>
        <span>AVEC</span>
        <span>EXCELLENCE</span>
      </h1>
      <p class="header-body">
        Serghini Frites est plus qu'un produit. C'est un concept culinaire marocain conçu pour l'hôtellerie haut de gamme. Des riads de charme aux établissements haut de gamme, nous créons des solutions sur mesure qui apportent notre perfection dorée à la table. Construisons ensemble quelque chose d'exceptionnel.
      </p>
    </div>

    <div class="action-cards">
       <a href="/wholesale" class="action-card">
         <img src="https://www.globalfries.be/site/assets/files/1269/straight-cut-10x10-hoopje-210125.1500x0.jpg" alt="Frites Serghini" class="card-image" />
         <span class="card-button">VENTE EN GROS</span>
       </a>
    </div>

    <div class="logo-carousel">
      <div class="carousel-track">
        <span class="partner-logo">Classic Fine Foods</span>
        <span class="partner-logo">Cretagel</span>
        <span class="partner-logo">FoodExpert</span>
        <span class="partner-logo">Nice To Meat</span>
        <span class="partner-logo">Ben Foods (S) Pte Ltd</span>
        <span class="partner-logo">Lamb Weston</span>
        <span class="partner-logo">Giraudi</span>
        <span class="partner-logo">Classic Fine Foods</span>
        <span class="partner-logo">Cretagel</span>
        <span class="partner-logo">FoodExpert</span>
        <span class="partner-logo">Nice To Meat</span>
        <span class="partner-logo">Ben Foods (S) Pte Ltd</span>
        <span class="partner-logo">Lamb Weston</span>
        <span class="partner-logo">Giraudi</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .partnerships {
    background-color: #F4EFE6;
    padding: 6rem 2rem;
  }

  .partnerships-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
  }

  .header-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #1A1A1A;
    margin-bottom: 1.5rem;
  }

  .header-title {
    display: flex;
    flex-direction: column;
    font-family: 'Titan One', var(--font-serif), system-ui, serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #1A1A1A;
    line-height: 0.95;
    margin-bottom: 2rem;
  }

  .header-body {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.7;
    color: #1A1A1A;
    opacity: 0.85;
  }

  .action-cards {
    display: flex;
    gap: 1.5rem;
    max-width: 1400px;
    margin: 0 auto 5rem;
  }

  .action-card {
    flex: 1;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: block;
    text-decoration: none;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .action-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    transition: background 0.3s ease;
  }

  .action-card:hover .card-overlay {
    background: rgba(0, 0, 0, 0.4);
  }

  .card-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FFFFFF;
    padding: 1rem 2.5rem;
    border: 1px solid #FFFFFF;
    border-radius: 50px;
    transition: all 0.3s ease;
    background: transparent;
    z-index: 2;
  }

  .action-card:hover .card-button {
    background-color: #FFFFFF;
    color: #1A1A1A;
  }

  .logo-carousel {
    overflow: hidden;
    padding: 2rem 0;
  }

  .carousel-track {
    display: flex;
    gap: 4rem;
    animation: scroll 30s linear infinite;
    width: max-content;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .partner-logo {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: #1A1A1A;
    white-space: nowrap;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .partner-logo:hover {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .action-cards {
      flex-direction: column;
    }

    .action-card {
      aspect-ratio: 4 / 3;
    }

    .partnerships {
      padding: 4rem 1.5rem;
    }
  }
</style>