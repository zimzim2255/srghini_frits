---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nos Produits">
  <section class="experience-hero">
    <div class="hero-background" style="background-image: url('https://goldenfries.com.au/wp-content/uploads/2024/08/Dishes_01.png')"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h6 class="hero-label">ALIMENTATION ET BOISSONS</h6>
      <h1 class="hero-headline">
        <span>EXPÉRIENCE</span>
        <span>LE FLAIR CRÉATIF</span>
        <span>D'UN MASTER</span>
      </h1>
      <p class="hero-body">
        Il s'agit de respecter des ingrédients simples et de les sublimer pour en faire profiter le monde entier. Une délicieuse sélection irrésistible de Frites spéciales, de snacks et de croquettes croustillantes, accompagnée de nos thés glacés maison et d'une carte de boissons élaborée avec soin.
      </p>
      <button class="hero-cta" onclick="smoothScroll('frites-menu')">
        FAITES DEFILER POUR DECOUVRIR
      </button>
    </div>
  </section>

   <section class="frites-menu">
    <div class="frites-header">
      <h2 class="frites-title">FRITES</h2>
      <p class="frites-description">
        Nos Frites sont élaborées à partir des meilleurs ingrédients naturels. Elles sont sans gluten, frites dans un mélange d'huiles végétales, de colza, de tournesol et de maïs.
      </p>
    </div>

    <div class="frites-grid">
       <a href="/produits/frites-with-sauce" class="frites-item-link">
         <div class="frites-item">
           <div class="frites-image-wrapper">
             <div class="frites-image" style="background-image: url('https://goldenfries.com.au/wp-content/uploads/2024/09/10mm-Fries-Images-%E2%80%93-5-1.png')"></div>
             <div class="frites-overlay">
               <span class="frites-overlay-title">FRITES WITH SAUCE</span>
             </div>
           </div>
           <h3 class="frites-item-title">FRITES WITH SAUCE</h3>
         </div>
       </a>

      <div class="frites-item">
        <div class="frites-image-wrapper">
          <div class="frites-image" style="background-image: url('https://goldenfries.com.au/wp-content/uploads/2024/09/13mm-Fries-Images-–-6-1.png')"></div>
          <div class="frites-overlay">
            <span class="frites-overlay-title">VEGGIE CHILI CON QUESO</span>
          </div>
        </div>
        <h3 class="frites-item-title">VEGGIE CHILI CON QUESO</h3>
      </div>

      <div class="frites-item">
        <div class="frites-image-wrapper">
          <div class="frites-image" style="background-image: url('https://goldenfries.com.au/wp-content/uploads/2024/09/GF_7mm_001c.png')"></div>
          <div class="frites-overlay">
            <span class="frites-overlay-title">PARMESAN & BASIL</span>
          </div>
        </div>
        <h3 class="frites-item-title">PARMESAN & BASIL</h3>
      </div>

      <div class="frites-item">
        <div class="frites-image-wrapper">
          <div class="frites-image" style="background-image: url('https://goldenfries.com.au/wp-content/uploads/2024/09/Steak-Fries-Images-–-8-1.png')"></div>
          <div class="frites-overlay">
            <span class="frites-overlay-title">INDO PEANUT</span>
          </div>
        </div>
        <h3 class="frites-item-title">INDO PEANUT</h3>
      </div>

      <div class="frites-item">
        <div class="frites-image-wrapper">
          <div class="frites-image" style="background-image: url('https://goldenfries.com.au/wp-content/uploads/2024/09/15mm-Fries-Images-–-7-1.png')"></div>
          <div class="frites-overlay">
            <span class="frites-overlay-title">SPICY ROYAL RENDANG</span>
          </div>
        </div>
        <h3 class="frites-item-title">SPICY ROYAL RENDANG</h3>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <section class="sell-section">
    <div class="sell-container">
      <h3 class="sell-title">COMMENCER À VENDRE NOS FRITES</h3>
      <p class="sell-text">
        Vous souhaitez proposer les fameuses Frites Serghini dans votre établissement? Nous serions ravis de vous entendre. Remplissez le formulaire et nous vous contacterons.
      </p>
      <a href="/contact" class="sell-btn">POSTULER MAINTENANT</a>
    </div>
  </section>

  <hr class="section-divider" />

  <section class="sauces-section">
    <div class="sauces-header">
      <h2 class="sauces-title">SAUCES</h2>
      <p class="sauces-description">
        Préparées en petites quantités pour compléter chaque Frites, de la plus classique à la plus audacieuse, chacune d'entre elles équilibre la saveur, la texture et la tradition. Tous ces produits sont fabriqués sans additifs artificiels.
      </p>
    </div>

     <div class="sauces-grid">
       <div class="sauce-item">
         <div class="sauce-image-wrapper">
           <div class="sauce-image" style="background-image: url('https://www.luxfries.com/assets/images/luxfries-3-115256-360x_.jpg')"></div>
           <div class="sauce-overlay">
             <span class="sauce-overlay-title">CLASSIC MAYO</span>
           </div>
         </div>
         <h3 class="sauce-item-title">CLASSIC MAYO</h3>
       </div>

       <div class="sauce-item">
         <div class="sauce-image-wrapper">
           <div class="sauce-image" style="background-image: url('https://www.luxfries.com/assets/images/luxfries-2-115329-360x_.jpg')"></div>
           <div class="sauce-overlay">
             <span class="sauce-overlay-title">TRUFFLE</span>
           </div>
         </div>
         <h3 class="sauce-item-title">TRUFFLE</h3>
       </div>

       <div class="sauce-item">
         <div class="sauce-image-wrapper">
           <div class="sauce-image" style="background-image: url('https://www.luxfries.com/assets/images/luxfries-1-115329-360x_.jpg')"></div>
           <div class="sauce-overlay">
             <span class="sauce-overlay-title">ANDALOUSE</span>
           </div>
         </div>
         <h3 class="sauce-item-title">ANDALOUSE</h3>
       </div>

       <div class="sauce-item">
         <div class="sauce-image-wrapper">
           <div class="sauce-image" style="background-image: url('https://www.luxfries.com/assets/images/luxfries-3-115425-360x360.jpg')"></div>
           <div class="sauce-overlay">
             <span class="sauce-overlay-title">BEARNAISE</span>
           </div>
         </div>
         <h3 class="sauce-item-title">BEARNAISE</h3>
       </div>

       <div class="sauce-item">
         <div class="sauce-image-wrapper">
           <div class="sauce-image" style="background-image: url('https://www.luxfries.com/assets/images/luxfries-2-115424-360x360.jpg')"></div>
           <div class="sauce-overlay">
             <span class="sauce-overlay-title">BASIL MAYO</span>
           </div>
         </div>
         <h3 class="sauce-item-title">BASIL MAYO</h3>
       </div>
     </div>
  </section>

  <hr class="section-divider" />

   <section class="ingredients">
     <div class="ingredients-top">
       <div class="ingredients-content">
         <h6 class="ingredients-label">NOS INGREDIENTS</h6>
         <h2 class="ingredients-headline">
           FABRIQUÉ À<br />
           PARTIR DES<br />
           MEILLEURS<br />
           INGRÉDIENTS
         </h2>
         <p class="ingredients-description">
           Seuls les ingrédients les plus frais sont utilisés pour nos spécialités et nos sauces. Rien d'artificiel, uniquement des ingrédients naturels. Toutes nos sauces sont faites maison et conservées dans des pots en céramique spécialement conçus pour préserver toute leur saveur.
         </p>
       </div>
     </div>
   </section>
</Layout>

<style>
  .experience-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 800px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .hero-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #F4F1EA;
    margin: 0;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2.5rem, 8vw, 5rem);
    color: #F4F1EA;
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
  }

  .hero-body {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.8;
    color: #F4F1EA;
    opacity: 0.9;
    max-width: 600px;
    margin: 0;
  }

  .hero-cta {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #F4F1EA;
    background: transparent;
    border: 1px solid #F4F1EA;
    padding: 1rem 2rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

   .hero-cta:hover {
     background-color: #F4F1EA;
     color: #000000;
   }

   .frites-menu {
    background-color: #F4EFE6;
    padding: 4rem 2rem 6rem;
  }

  .frites-header {
    text-align: center;
    max-width: 500px;
    margin: 0 auto 4rem;
  }

  .frites-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 8vw, 6rem);
    color: #1A1A1A;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    line-height: 0.9;
  }

  .frites-description {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    color: #1A1A1A;
    opacity: 0.85;
  }

  .frites-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  .frites-item {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .frites-item-link {\n    display: flex;\n    flex-direction: column;\n    text-decoration: none;\n    color: inherit;\n    height: 100%;\n    transition: transform 0.3s ease, opacity 0.3s ease;\n  }\n\n  .frites-item-link:hover {\n    transform: translateY(-4px);\n    opacity: 0.9;\n  }\n\n  .frites-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .frites-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .frites-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #8B0000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .frites-overlay-title {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #F4F1EA;
    text-align: center;
    line-height: 1.2;
    padding: 1rem;
  }

    .frites-item-title {
      font-family: var(--font-sans);
      font-size: 0.875rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #1A1A1A;
      letter-spacing: 0.05em;
      margin: 0;
    }

    .frites-item:hover .frites-overlay {
      opacity: 1;
    }

    @media (max-width: 1024px) {
      .frites-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

  @media (max-width: 768px) {
    .frites-menu {
      padding: 3rem 1.5rem 4rem;
    }

    .frites-header {
      margin-bottom: 3rem;
    }

    .frites-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .frites-image {
      aspect-ratio: 1;
    }

    .frites-item-title {
      font-size: 0.75rem;
    }
  }

    @media (max-width: 480px) {
      .frites-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
    }

   @media (max-width: 768px) {
     .hero-content {
       padding: 1.5rem;
       gap: 1.5rem;
     }
   }

   .section-divider {
     border: none;
     height: 1px;
     background-color: #E0D8C8;
     margin: 0;
   }

   .sauces-section,
   .snacks-section,
   .drinks-section {
     background-color: #F4EFE6;
     padding: 4rem 2rem 6rem;
   }

   .sauces-header,
   .snacks-header,
   .drinks-header {
     text-align: center;
     max-width: 600px;
     margin: 0 auto 4rem;
   }

   .sauces-title,
   .snacks-title,
   .drinks-title {
     font-family: var(--font-serif);
     font-size: clamp(3rem, 8vw, 6rem);
     color: #1A1A1A;
     text-transform: uppercase;
     margin-bottom: 1.5rem;
     line-height: 0.9;
   }

   .drinks-title {
     display: flex;
     flex-direction: column;
     gap: 0.25rem;
   }

   .sauces-description,
   .snacks-description,
   .drinks-description {
     font-family: var(--font-sans);
     font-size: 1rem;
     line-height: 1.7;
     color: #1A1A1A;
     opacity: 0.85;
   }

   .sauces-grid,
   .snacks-grid,
   .drinks-grid {
     display: grid;
     grid-template-columns: repeat(5, 1fr);
     gap: 1.5rem;
     max-width: 1600px;
     margin: 0 auto;
   }

   .sauce-item,
   .snack-item,
   .drink-item {
     display: flex;
     flex-direction: column;
   }

   .sauce-image-wrapper,
   .snack-image-wrapper,
   .drink-image-wrapper {
     position: relative;
     width: 100%;
     aspect-ratio: 1/1;
     overflow: hidden;
     border-radius: 4px;
     margin-bottom: 1rem;
   }

   .sauce-image,
   .snack-image,
   .drink-image {
     width: 100%;
     height: 100%;
     background-size: cover;
     background-position: center;
   }

   .sauce-overlay,
   .snack-overlay,
   .drink-overlay {
     position: absolute;
     top: 0;
     left: 0;
     width: 100%;
     height: 100%;
     background-color: #8B0000;
     display: flex;
     align-items: center;
     justify-content: center;
     opacity: 0;
     transition: opacity 0.4s ease;
   }

   .sauce-overlay-title,
   .snack-overlay-title,
   .drink-overlay-title {
     font-family: var(--font-serif);
     font-size: clamp(0.9rem, 2vw, 1.25rem);
     font-weight: 700;
     text-transform: uppercase;
     color: #F4F1EA;
     text-align: center;
     line-height: 1.2;
     padding: 1rem;
   }

   .sauce-item-title,
   .snack-item-title,
   .drink-item-title {
     font-family: var(--font-sans);
     font-size: 0.875rem;
     font-weight: 700;
     text-transform: uppercase;
     color: #1A1A1A;
     letter-spacing: 0.05em;
     margin: 0;
   }

   .sauce-item:hover .sauce-overlay,
   .snack-item:hover .snack-overlay,
   .drink-item:hover .drink-overlay {
     opacity: 1;
   }

   .snack-item:nth-child(6),
   .snack-item:nth-child(7) {
     grid-column: span 1;
   }

   @media (max-width: 1024px) {
     .sauces-grid,
     .snacks-grid,
     .drinks-grid {
       grid-template-columns: repeat(3, 1fr);
     }

     .snack-item:nth-child(6),
     .snack-item:nth-child(7) {
       grid-column: span 1;
     }
   }

   @media (max-width: 768px) {
     .sauces-section,
     .snacks-section,
     .drinks-section {
       padding: 3rem 1.5rem 4rem;
     }

     .sauces-header,
     .snacks-header,
     .drinks-header {
       margin-bottom: 3rem;
     }

     .sauces-grid,
     .snacks-grid,
     .drinks-grid {
       grid-template-columns: repeat(2, 1fr);
       gap: 1rem;
     }

     .sauce-image-wrapper,
     .snack-image-wrapper,
     .drink-image-wrapper {
       aspect-ratio: 1;
     }

     .sauce-item-title,
     .snack-item-title,
     .drink-item-title {
       font-size: 0.75rem;
     }
   }

    @media (max-width: 480px) {
      .frites-grid,
      .sauces-grid,
      .snacks-grid,
      .drinks-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
    }

    .ingredients {
      background-color: #ff5f1f;
      width: 100%;
    }

   .ingredients-top {
     width: 100%;
     padding: 6rem 2rem 4rem;
     display: flex;
     justify-content: center;
   }

   .ingredients-content {
     text-align: center;
     max-width: 600px;
   }

   .ingredients-label {
     display: block;
     font-family: var(--font-sans);
     font-size: 0.75rem;
     font-weight: 400;
     letter-spacing: 0.3em;
     text-transform: uppercase;
     color: #F4F1EA;
     margin-bottom: 2rem;
   }

   .ingredients-headline {
     font-family: var(--font-serif);
     font-size: clamp(2.5rem, 6vw, 4.5rem);
     color: #F4F1EA;
     line-height: 1.1;
     margin-bottom: 2rem;
     text-transform: uppercase;
   }

   .ingredients-description {
     font-family: var(--font-sans);
     font-size: 1rem;
     line-height: 1.7;
     color: #F4F1EA;
     opacity: 0.85;
   }

    .ingredients-bottom {
      position: relative;
      width: 100%;
      padding: 0 2rem 4rem;
      overflow: hidden;
    }
  
    .ingredients-collage {
      display: flex;
      width: 100%;
      height: 50vh;
      gap: 0.5rem;
      padding: 0 10vw;
      will-change: transform;
    }
  
    .ingredient-img {
      position: relative;
      overflow: hidden;
      border-radius: 4px;
      flex-shrink: 0;
      will-change: transform;
      transform: translateX(0);
    }
  
    .ingredient-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  
    .img-1 {
      flex: 1;
      min-width: 0;
    }
  
    .img-2 {
      flex: 1.2;
      min-width: 0;
    }
  
    .img-3 {
      flex: 1.8;
      min-width: 0;
    }
  
    .img-4 {
      flex: 1;
      min-width: 0;
    }
  
    .img-5 {
      flex: 1.3;
       min-width: 0;
     }
    
    @media (max-width: 768px) {
      .ingredients-top {
        padding: 4rem 1.5rem 3rem;
      }
  
      .ingredients-bottom {
        padding: 0 1.5rem 3rem;
      }
  
      .ingredients-collage {
        height: 70vh;
        gap: 1rem;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        grid-auto-flow: column;
        grid-auto-columns: calc(100% - 1rem);
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        will-change: transform;
        transform: none !important;
      }
  
      .ingredient-img {
        width: 100%;
        height: 100%;
        scroll-snap-align: center;
        flex: none;
        transform: none !important;
        will-change: auto;
      }

      .ingredient-img img {
        height: 100%;
      }

      .ingredients-collage::-webkit-scrollbar {
        height: 6px;
      }

      .ingredients-collage::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.1);
        border-radius: 3px;
      }

      .ingredients-collage::-webkit-scrollbar-thumb {
        background: #8B0000;
        border-radius: 3px;
      }
    }

     @media (max-width: 480px) {
       .ingredients-collage {
         height: 60vh;
         gap: 0.75rem;
       }
     }

     .nav-btn {
       font-size: 0.625rem;
       padding: 0.5rem 1rem;
     }

      .menu-icon {
        width: 36px;
        height: 36px;
      }

    @media (max-width: 480px) {
     .ingredients-collage {
       flex-direction: column;
       height: auto;
       padding: 0;
       overflow: visible;
     }

     .ingredient-img {
       transform: none !important;
       will-change: auto;
     }

      .img-1, .img-2, .img-3, .img-4, .img-5 {
        flex: none;
        height: 150px;
        width: 100% !important;
       }
     }
     @media (min-width: 1024px) {
       .ingredients {
         display: flex;
         align-items: center;
       }

       .ingredients-top,
       .ingredients-bottom {
         width: 50%;
       }

       .ingredients-top {
         justify-content: flex-start;
         padding: 6rem 4rem 4rem;
         text-align: left;
       }

       .ingredients-content {
         text-align: left;
         max-width: none;
       }

       .ingredients-bottom {
         padding: 0 4rem 4rem;
       }

       .ingredients-collage {
         height: 60vh;
       }

       .img-1 { flex: 2; }
       .img-2 { flex: 2.5; }
       .img-3 { flex: 3.5; }
       .img-4 { flex: 2; }
       .img-5 { flex: 2.6; }
     }

   .sell-section {
    background-color: #d32f2f;
    padding: 4rem 2rem;
    text-align: center;
  }

  .sell-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .sell-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #F4F1EA;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .sell-text {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.7;
    color: #F4F1EA;
    opacity: 0.9;
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .sell-btn {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #111D3D;
    background-color: #F4EFE6;
    border: 2px solid #F4EFE6;
    border-radius: 50px;
    padding: 1rem 2rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .sell-btn:hover {
    background-color: transparent;
    color: #F4EFE6;
  }

  @media (max-width: 768px) {
    .sell-section {
      padding: 3rem 1.5rem;
    }
    
    .sell-text {
      font-size: 1rem;
    }
  }

    @media (max-width: 480px) {
      .ingredients-collage {
        flex-direction: column;
        height: auto;
        padding: 0;
        overflow: visible;
      }

      .ingredient-img {
        transform: none !important;
        will-change: auto;
      }

       .img-1, .img-2, .img-3, .img-4, .img-5 {
         flex: none;
         height: 150px;
         width: 100% !important;
       }
     }
  </style>

  <script>
    function smoothScroll(targetId: string) {
      const target = document.getElementById(targetId);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // Scroll-linked parallax animation for ingredients collage
    const ingredientElements = document.querySelectorAll('.ingredient-img');
    const ingredientImages = Array.from(ingredientElements) as HTMLElement[];
    let lastScrollY = window.scrollY;
    let accumulatedX = 0;
    let rafId: number | null = null;

    // On small devices, use scroll-snap gallery instead of parallax
    const isSmallDevice = window.matchMedia('(max-width: 767px)').matches;

    if (!isSmallDevice) {
      // Detect if device supports hover (not touch-only) for larger screens
      const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
      const speedFactor = isTouchDevice ? 0.3 : 0.6;

      function updateParallax() {
        const currentScrollY = window.scrollY;
        const scrollDelta = currentScrollY - lastScrollY;
        lastScrollY = currentScrollY;

        // Accumulate horizontal offset based on scroll direction (reverse: scroll down moves left)
        accumulatedX -= scrollDelta * speedFactor;

        // Apply transform to each image with a slight variation for organic feel
        ingredientImages.forEach((img, index) => {
          const variation = index * 5; // Small offset per image for layered effect
          img.style.transform = `translate3d(${accumulatedX + variation}px, 0, 0)`;
        });

        rafId = requestAnimationFrame(updateParallax);
      }

      // Start animation only when ingredients section is in view
      const ingredientsSection = document.querySelector('.ingredients');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            lastScrollY = window.scrollY;
            if (!rafId) {
              rafId = requestAnimationFrame(updateParallax);
            }
          } else if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
        });
      }, { threshold: 0.1 });

      if (ingredientsSection) {
        observer.observe(ingredientsSection);
      }

      // Respect reduced motion preference
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        ingredientImages.forEach(img => {
          img.style.transform = 'translateX(0)';
        });
      }
    }
  </script>

