<style>
  .footer {
    width: 100%;
    margin-top: auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 5rem 4rem;
    background-color: #F4EFE6;
    gap: 4rem;
  }

  .footer-logo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .logo-img {
    width: 180px;
    height: auto;
  }

  .logo-tagline {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #1A1A1A;
  }

  .footer-links {
    display: flex;
    gap: 4rem;
  }

  .link-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .link-column a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1A1A1A;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .link-column a:hover {
    opacity: 0.6;
  }

  .footer-bottom {
    background-color: #D32F2F;
    padding: 1.5rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-legal {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-legal a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-legal a:hover {
    color: rgba(255, 255, 255, 0.9);
  }

   .separator {
     opacity: 0.4;
   }

   .footer-contact {
     font-family: var(--font-sans);
     font-size: 0.8rem;
     color: rgba(255, 255, 255, 0.6);
     text-align: right;
   }

   .footer-contact p {
     margin: 0.25rem 0;
   }

   .footer-contact a {
     color: rgba(255, 255, 255, 0.8);
     text-decoration: none;
     transition: color 0.3s ease;
   }

   .footer-contact a:hover {
     color: #FFFFFF;
   }

   @media (max-width: 1024px) {
    .footer-top {
      flex-direction: column;
      padding: 4rem 2rem;
      gap: 3rem;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 2.5rem;
    }

     .footer-bottom {
       padding: 1.5rem 2rem;
       flex-direction: column;
       text-align: center;
     }

     .footer-legal {
       flex-wrap: wrap;
       justify-content: center;
     }

     .footer-contact {
       text-align: center;
     }

    .footer-legal {
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer-contact {
      text-align: center;
    }
