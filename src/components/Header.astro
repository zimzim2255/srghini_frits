---
---

<header class="header">
  <a href="/" class="logo">
    <img src="/assets/logos/delivrables/PNG/full-colors.png" alt="Serghini Frites" />
  </a>
  <button class="menu-toggle" id="menuToggle" aria-label="Open menu">
    <span class="hamburger"></span>
  </button>
</header>

<div class="nav-overlay" id="navOverlay">
  <div class="nav-backdrop" id="navBackdrop"></div>
  <div class="nav-panel">
    <div class="nav-top">
      <a href="/wholesale" class="btn-pill">WHOLESALE</a>
      <button class="close-btn" id="navClose" aria-label="Close menu">✕</button>
    </div>

    <div class="nav-content">
        <nav class="main-menu">
          <a href="/">ACCUEIL</a>
          <a href="/histoire">NOTRE HISTOIRE</a>
          <a href="/produits">NOS PRODUITS</a>
          <a href="/locations">NOS ATELIERS</a>
          <a href="/employment">OFFRES D'EMPLOI</a>
          <a href="/partenaires">PARTENARIATS</a>
          <a href="/contact">SELL OUR POTATOES</a>
        </nav>
    <nav class="location-menu">
         <a href="/locations#anvers">ANVERS</a>
       </nav>
    </div>

    <div class="nav-footer">
<div class="lang-switch">
         <a href="#" class="active">FR</a>
       </div>
      <div class="social-links">
        <a href="#">INSTAGRAM</a>
        <a href="#">FACEBOOK</a>
        <a href="#">LINKEDIN</a>
        <a href="#">TIKTOK</a>
      </div>
    </div>
  </div>
</div>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const navOverlay = document.getElementById('navOverlay');
  const navClose = document.getElementById('navClose');
  const navBackdrop = document.getElementById('navBackdrop');
  const header = document.querySelector('.header');

  menuToggle?.addEventListener('click', () => {
    navOverlay?.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  const closeMenu = () => {
    navOverlay?.classList.remove('active');
    document.body.style.overflow = '';
  };

  navClose?.addEventListener('click', closeMenu);
  navBackdrop?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
  }

  .header.scrolled {
    background: transparent;
  }

  .logo {
    display: block;
    width: 100px;
  }

  .logo img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .logo {
      width: 80px;
    }
  }

  .menu-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hamburger {
    display: block;
    width: 28px;
    height: 2px;
    background-color: var(--color-white);
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 28px;
    height: 2px;
    background-color: var(--color-white);
    left: 0;
  }

  .hamburger::before {
    top: -8px;
  }

  .hamburger::after {
    top: 8px;
  }

  .nav-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .nav-overlay.active {
    pointer-events: auto;
    opacity: 1;
  }

  .nav-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .nav-overlay.active .nav-backdrop {
    opacity: 1;
  }

  .nav-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 70%;
    max-width: 900px;
    height: 100%;
    background: #F4EFE6;
    padding: 4rem;
    transform: translateX(100%);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .nav-overlay.active .nav-panel {
    transform: translateX(0);
  }

  .nav-top {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 5rem;
  }

  .btn-pill {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border: 1px solid #1A1A1A;
    border-radius: 50px;
    transition: all 0.3s ease;
  }

  .btn-pill:hover {
    background: #1A1A1A;
    color: #FFFFFF;
  }

  .close-btn {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: #1A1A1A;
    cursor: pointer;
    padding: 0.5rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .close-btn:hover {
    transform: rotate(90deg);
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    flex: 1;
    gap: 2rem;
  }

  .main-menu {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .main-menu a {
    font-family: 'Titan One', var(--font-serif), system-ui, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #1A1A1A;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.3s ease, transform 0.3s ease;
    display: inline-block;
  }

  .main-menu a:hover {
    opacity: 0.6;
    transform: translateX(8px);
  }

  .location-menu {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: right;
  }

  .location-menu a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1A1A;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .location-menu a:hover {
    color: #111D3D;
  }

  .nav-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 3rem;
  }

  .lang-switch {
    display: flex;
    gap: 1rem;
  }

  .lang-switch a {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
    text-decoration: none;
    opacity: 0.6;
  }

  .lang-switch a.active {
    font-weight: 700;
    opacity: 1;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
  }

  .social-links a {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .social-links a:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .nav-panel {
      width: 100%;
      max-width: 100%;
      padding: 4rem 1.5rem 1.5rem;
    }

    .nav-top {
      margin-bottom: 1rem;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .btn-pill {
      font-size: 0.6rem;
      padding: 0.5rem 1rem;
    }

    .nav-content {
      flex-direction: column;
      gap: 1.5rem;
    }

    .location-menu {
      text-align: left;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .nav-footer {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .social-links {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .main-menu a {
      font-size: 1.5rem;
    }
  }
</style>
